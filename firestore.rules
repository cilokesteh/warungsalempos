rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // This Firebase project hosts two isolated apps. Never use a generic
    // "request.auth != null" rule here: the public demo account must not read
    // Warung Salem production data.
    function isDemoAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@tokodemo.com';
    }

    function isWarungAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@warungsalem.com';
    }

    match /demo-products/{id} {
      allow read, write: if isDemoAdmin();
    }

    match /demo-transactions/{id} {
      allow read, update, delete: if isDemoAdmin();
      allow create: if isDemoAdmin()
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.timestamp == request.time;
    }

    match /demo-customers/{id} {
      allow read, write: if isDemoAdmin();
    }

    match /products/{id} {
      allow read, write: if isWarungAdmin();
    }

    match /transactions/{id} {
      allow read, update, delete: if isWarungAdmin();
      allow create: if isWarungAdmin()
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.timestamp == request.time;
    }

    match /customers/{id} {
      allow read, write: if isWarungAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
